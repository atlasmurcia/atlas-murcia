+// Los «sí/ok/vale» sin contexto pertenecen al flujo que ya estaba abierto.
+export function isExplicitReminderConfirmation(text, actionId = "") {
+  return reminderResponseKind(text, actionId) === "confirmed" &&
+    (/^(?:atlas[-_:])?confirm(?:ar)?[-_:]?cita$/i.test(String(actionId).trim()) || String(text).trim() === "confirmar" || confirmationWords.test(String(text)));
+}
+
+export function isActiveRebook(rebook, now = Date.now()) {
+  if (!rebook?.state || rebook.state === "closed") return false;
+  const expiresAt = Date.parse(rebook.expiresAt || "");
+  return !Number.isFinite(expiresAt) || expiresAt >= now;
+}
