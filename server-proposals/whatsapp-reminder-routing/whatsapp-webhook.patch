+// Solo permite atravesar una reagendación si hay un recordatorio vigente y vinculado.
+async function reminderJobsDuringRebook(connection: any, conversation: any, inbound: any) {
+  if (!isActiveRebook(conversation.metadata?.rebook)) return [];
+  const normalized = normalizedReply(textReply(inbound)), actionId = replyId(inbound);
+  if (!reminderResponseKind(normalized, actionId)) return [];
+  const contextId = String(inbound?.payload?.context?.id || "").trim();
+  if (!contextId && !isExplicitReminderConfirmation(normalized, actionId)) return [];
+  if (!contextId) {
+    const selected = await db.from("whatsapp_appointment_options").select("id").eq("clinic_id", connection.clinic_id).eq("conversation_id", conversation.id).eq("status", "selected").gt("expires_at", new Date().toISOString()).limit(1).maybeSingle();
+    if (selected.error) throw selected.error;
+    if (selected.data) return [];
+  }
+  let patientId = conversation.patient_id;
+  if (!patientId) {
+    const patients = await db.from("patients").select("id").eq("clinic_id", connection.clinic_id).is("deleted_at", null).in("phone", patientPhoneVariants(conversation.contact_phone)).limit(2);
+    if (patients.error) throw patients.error;
+    if (patients.data?.length !== 1) return [];
+    patientId = patients.data[0].id;
+  }
+  const now = new Date().toISOString();
+  let query = db.from("appointment_reminder_jobs").select("appointment_id,patient_id,sent_at,appointment:appointments(id,patient_id,starts_at,metadata,status,deleted_at)").eq("clinic_id", connection.clinic_id).eq("patient_id", patientId).eq("phone", normalizePhone(conversation.contact_phone)).eq("status", "sent").gt("appointment_starts_at", now);
+  if (contextId) query = query.eq("provider_message_id", contextId);
+  else query = query.gte("sent_at", new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString());
+  const result = await query.order("sent_at", { ascending: false }).limit(20);
+  if (result.error) throw result.error;
+  const jobs = (result.data || []).filter((job: any) => {
+    const appointment = Array.isArray(job.appointment) ? job.appointment[0] : job.appointment;
+    return appointment?.patient_id === patientId && !appointment.deleted_at && new Date(appointment.starts_at).getTime() > Date.now() && !["cancelled", "cancelada", "completed", "completada"].includes(String(appointment.status || "").toLowerCase());
+  });
+  // Conservar el recordatorio exacto, o el día del envío más reciente si se respondió por texto.
+  const latestDay = jobs[0]?.sent_at && madridDate(jobs[0].sent_at);
+  return contextId ? jobs : jobs.filter((job: any) => job.sent_at && madridDate(job.sent_at) === latestDay);
+}
+
+async function handleInboundAutomations(connection: any, conversation: any, inbound: any, message: any) {
+  const priorityJobs = await reminderJobsDuringRebook(connection, conversation, inbound);
+  if (priorityJobs.length) {
+    await handleReminderConfirmation(connection, conversation, inbound, priorityJobs);
+    return;
+  }
+  await handleSelection(connection, conversation, inbound, message);
+  await handleSelectedReply(connection, conversation, inbound);
+  await handleCancellationRebook(connection, conversation, inbound);
+  await handleReminderConfirmation(connection, conversation, inbound);
+}
